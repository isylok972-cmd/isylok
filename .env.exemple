# ===========================================
# Event-Gérance Pro — Template de Configuration
# ===========================================
# Copiez ce fichier en .env et remplissez les valeurs

# Base de données
DATABASE_URL="file:./dev.db"

# Authentification
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="changez-moi-avec-une-valeur-securisee"

# Email (SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_EXPEDITEUR=""

# Application
NOM_ENTREPRISE="Event-Gérance Pro"
DEVISE="EUR"
TVA_TAUX="20"
